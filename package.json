{
  "name": "prabayoga-website",
  "version": "1.0.0",
  "private": true,
  "description": "Praba Yoga & Wellbeing Centre – static marketing website",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./src/css/main.css -o ./assets/css/main.css --minify",
    "build:js": "esbuild src/js/main.js --bundle --minify --format=iife --target=es2019 --outfile=assets/js/main.js",
    "watch:css": "tailwindcss -i ./src/css/main.css -o ./assets/css/main.css --watch",
    "watch:js": "esbuild src/js/main.js --bundle --format=iife --target=es2019 --outfile=assets/js/main.js --watch",
    "serve": "npx --yes serve . -l 3000",
    "dev": "concurrently -k -n css,js,serve \"npm:watch:css\" \"npm:watch:js\" \"npm:serve\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
